# Kshetra (formerly TERRAWISE AI) Environment Configuration
# Copy this file to .env and fill in strong secrets before running in production.

FLASK_ENV=development
SECRET_KEY=replace-with-at-least-32-random-bytes-in-production
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes-in-production
DATABASE_URL=sqlite:///kshetra.db

# Operational Limits
MAX_FARMERS=20
MAX_PARCELS_PER_FARMER=4
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000

# Krishi Mitra AI Assistant Provider (auto | gemini | openai | deterministic)
ASSISTANT_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
ASSISTANT_HOURLY_MSG_LIMIT=30
ASSISTANT_DAILY_TOKEN_BUDGET=25000
ASSISTANT_RETENTION_DAYS=90

# External Telemetry & Market Feeds
AGMARKNET_API_KEY=

# Optional Support Contact & Public Reachability (shown only if configured)
SUPPORT_CONTACT=
KSHETRA_PUBLIC_URL=
ALLOW_LAN_ORIGINS=1
