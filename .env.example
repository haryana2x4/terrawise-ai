# ==============================================================================
# Kshetra — Environment Configuration Template
# Copy this file to `.env` in the repository root before running locally.
# ==============================================================================

# --- Kshetra Backend (Flask / SQLite) ---
FLASK_SECRET_KEY=replace_with_a_strong_32_byte_random_secret_key
MAX_FARMERS=20
PORT=5000

# --- Kshetra Frontend (Vite / Maps) ---
# Optional: Google Maps JavaScript API key for high-res satellite tiles.
# Falls back automatically to Leaflet + OpenStreetMap + NASA GIBS if left blank.
VITE_GOOGLE_MAPS_KEY=

# --- External Agricultural Data Feeds (Optional) ---
# Optional: data.gov.in Agmarknet API key for live APMC mandi prices.
DATA_GOV_IN_API_KEY=

# Optional: Copernicus Data Space Ecosystem (Sentinel-2 NDVI) OAuth credentials.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# --- SUNDAY AI Bot (`services/ai-bot`) ---
SUNDAY_PORT=8765
OLLAMA_HOST=http://127.0.0.1:11434

# --- Orien / Beyond Earth Module (`modules/orien`) ---
VITE_ORIEN_API_BASE=/functions/v1/app
