# ==============================================================================
# TERRAWISE AI Monorepo — Environment Configuration (.env.example)
# Copy this file to .env and fill in optional keys as needed.
# ==============================================================================

# --- TERRAWISE AI Backend (backend/app.py) ---
FLASK_SECRET_KEY=replace_with_your_random_flask_secret_key
MAX_FARMERS=20
PORT=5000

# Optional Google Maps API Key for satellite imagery tiles
# (Falls back to Leaflet + OpenStreetMap + NASA GIBS when omitted)
VITE_GOOGLE_MAPS_KEY=

# Optional data.gov.in API Key for live APMC Mandi rates
DATA_GOV_IN_API_KEY=

# Optional Copernicus Data Space Ecosystem (CDSE) credentials for Sentinel-2 NDVI
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# --- SUNDAY v2 AI Bot (services/ai-bot/server.js) ---
AI_BOT_PORT=8765
AI_BOT_HOST=127.0.0.1
LLM_PROVIDER=local_embedded
LLM_MODEL=sunday-local-3b-q4
WHISPER_MODEL=small.en
TTS_ENGINE=kokoro_offline
AIR_GAPPED_MODE=true
ALLOW_CLOUD_TELEMETRY=false
