# ==============================================================================
# SUNDAY v2: SovereignDev Environment Configuration
# 100% Local-First & Air-Gapped Operation
# ==============================================================================

# Server Network Settings
PORT=8765
HOST=127.0.0.1
NODE_ENV=production

# Local Engine & Model Settings
LLM_PROVIDER=local_embedded
LLM_MODEL=sunday-local-3b-q4
WHISPER_MODEL=small.en
TTS_ENGINE=kokoro_offline

# Hardware Acceleration
GPU_ACCELERATION=cuda
TARGET_FPS=60.0
MAX_VRAM_MB=6144

# Security & Governance
AIR_GAPPED_MODE=true
ALLOW_CLOUD_TELEMETRY=false
SANDBOX_TIMEOUT_MS=5000
RATE_LIMIT_MAX_REQUESTS_PER_MIN=120
