{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Kshetra: Run Full Stack (start.py)",
      "type": "shell",
      "command": "python",
      "args": ["start.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "owner": "kshetra-fullstack",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\[KSHETRA\\] Project root:",
          "endsPattern": "Kshetra App\\s+:"
        }
      }
    },
    {
      "label": "Kshetra: Frontend Dev Server (Vite :5173)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev", "--", "--host", "127.0.0.1", "--port", "5173", "--strictPort"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "kshetra-vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "Local:\\s+http://"
        }
      }
    },
    {
      "label": "Kshetra: Backend Flask (:5000)",
      "type": "shell",
      "command": "python",
      "args": ["wsgi.py"],
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "HOST": "127.0.0.1",
          "PORT": "5000",
          "PYTHONUNBUFFERED": "1"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Kshetra: Setup & Bootstrap Check",
      "type": "shell",
      "command": "python",
      "args": ["start.py", "--check-only"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Kshetra: Create Initial Admin (CLI)",
      "type": "shell",
      "command": "python",
      "args": ["-m", "flask", "--app", "wsgi", "create-admin", "--admin-id", "ADMIN"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "Kshetra: System Doctor Check",
      "type": "shell",
      "command": "python",
      "args": ["-m", "flask", "--app", "wsgi", "doctor"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "Kshetra: Share App on LAN (Single-Port Production)",
      "type": "shell",
      "command": "python",
      "args": ["start.py", "--share", "--prod"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Kshetra: Verify All (Guard + Pytest + Typecheck + Build)",
      "type": "shell",
      "command": "python",
      "args": [
        "-c",
        "import shutil, subprocess, sys; npm = shutil.which('npm.cmd') or shutil.which('npm'); npx = shutil.which('npx.cmd') or shutil.which('npx'); cmds = [([sys.executable, 'scripts/check_no_demo.py'], '.'), ([sys.executable, '-m', 'pytest', '-v'], '.'), ([npx, 'tsc', '--noEmit'], 'frontend'), ([npm, 'run', 'build'], 'frontend')]; [subprocess.run(c, cwd=d, check=True) for c, d in cmds]"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
